# THE ONE PLACE for this rebrand's name, bundle ID and signing (REBRAND.md).
# Scripts/make-app.sh reads this file and writes these values into the app's Info.plist; the Swift
# code reads them back from Info.plist at runtime (Sources/SillHost/HostBrand.swift), so renaming
# the app is a change to BRAND_NAME (and BRAND_BUNDLE_ID) here and nothing else.
#
# Never change here: the wire protocol, _sill._tcp, the sill/1 and sill-pair/1 ALPNs, sill:// pairing
# links. Those stay stock Sill's so the stock Sill iPhone app and the Sage TV "Macs" tab both connect.

BRAND_NAME="Overlook"
BRAND_BUNDLE_ID="cloud.agentlumi.overlook.mac"
# What the person opens on the phone, as the app's words say it ("Open … on your iPhone or iPad").
BRAND_PHONE_APPS="Sill or Sage TV"
# 0: no update check, no request to GitHub or anyone else's server (stock Sill asks GitHub once a day).
BRAND_UPDATE_CHECK=0
# The signing identity (a SHA-1 hash or name from `security find-identity -v -p codesigning`).
# Keep it stable: Screen Recording and Accessibility grants follow the certificate's name.
BRAND_SIGN_IDENTITY="CCB26D66FD40EF5F471BB2ACBD0479B48A32F92B"
